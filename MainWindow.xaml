<Window x:Class="SpeakingTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Speaking Trainer"
        Height="740"
        Width="800"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Grid Background="#FAFAFA">
        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Width="680">

            <TextBlock
                Text="LISTEN &amp; REPEAT"
                FontSize="18"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                Margin="0,0,0,12"/>

            <TextBlock x:Name="ChunkPosition"
                       Text="청크 준비 중"
                       FontSize="16" Foreground="#555555"
                       HorizontalAlignment="Center" Margin="0,0,0,23"/>

            <TextBlock x:Name="MicrophoneStatus" Text="마이크 준비 중"
                       FontSize="13" Foreground="#287A46" TextAlignment="Center"
                       Margin="0,0,0,16"/>

            <TextBlock
                x:Name="ChunkText"
                Text="I think one of the biggest mistakes people make when learning a language is focusing too much on being perfect."
                FontSize="32"
                FontWeight="SemiBold"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Foreground="Gray"
                ToolTip="인식된 단어만 강조합니다. 주황색은 인식 중이며 수정될 수 있고, 파란색은 확정된 인식입니다."
                Margin="0,0,0,35"/>

            <TextBlock Text="주황: 인식 중 · 파랑: 확정 · 회색: 미인식"
                       FontSize="13" Foreground="#555555" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock x:Name="RecognitionText" Text="인식: —" TextWrapping="Wrap"
                       MaxHeight="60" FontSize="14" Foreground="#555555" TextAlignment="Center" Margin="0,0,0,16"/>

            <TextBlock
                x:Name="StatusText"
                Text="Preparing..."
                FontSize="18"
                HorizontalAlignment="Center"
                Margin="0,0,0,25"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                <TextBlock Text="MFCC/DTW 최대 거리 (실험용): " VerticalAlignment="Center"/>
                <TextBox x:Name="AcousticThreshold" Width="90" TextChanged="AcousticThreshold_Changed"
                         ToolTip="낮을수록 엄격합니다. 비워두면 unit.json 설정을 사용하며, 설정이 없으면 측정만 합니다."/>
            </StackPanel>
            <TextBox x:Name="AcousticResults" IsReadOnly="True" Height="90" Margin="0,0,0,12"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Text="음향 거리 실험입니다. 임계값이 없으면 측정만 하고 같은 청크를 재시도합니다."/>

            <Button
                x:Name="ReplayButton"
                Content="↻ Replay"
                Width="120"
                Height="40"
                Click="ReplayButton_Click"/>

        </StackPanel>
    </Grid>
</Window>
