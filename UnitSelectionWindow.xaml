<Window x:Class="SpeakingTrainer.UnitSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select a Unit"
        Width="760"
        Height="470"
        MinWidth="620"
        MinHeight="380"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Choose a chapter and unit"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,20"/>

        <!-- 챕터 및 유닛 선택 / Chapter and unit selection -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top"
                           Text="CHAPTERS"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <ListBox x:Name="ChapterList"
                         DisplayMemberPath="Title"
                         SelectionChanged="ChapterList_SelectionChanged"/>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top"
                           Text="UNITS"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <ListBox x:Name="UnitList"
                         DisplayMemberPath="Title"
                         SelectionChanged="UnitList_SelectionChanged"/>
            </DockPanel>
        </Grid>

        <!-- 학습 시작 버튼 / Start drill button -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Cancel"
                    Width="100"
                    Height="36"
                    Margin="0,0,10,0"
                    IsCancel="True"/>

            <Button x:Name="StartButton"
                    Content="Start Drill"
                    Width="130"
                    Height="36"
                    IsEnabled="False"
                    IsDefault="True"
                    Click="StartButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
